FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg2://orcaquant:orcaquant@localhost:5432/orcaquant
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Feature toggles
ENABLE_BILLING=false
ENABLE_REALTIME=false

# Account lifecycle / verification code boundary
ACCOUNT_VERIFICATION_CODE_TTL_MINUTES=10
ACCOUNT_VERIFICATION_MAX_ATTEMPTS=5
ACCOUNT_CODE_CHANNEL=email
ACCOUNT_CODE_DEBUG_RESPONSE=false

# Billing provider boundary
BILLING_PROVIDER=fake
BILLING_ALLOWED_CURRENCIES=TRY,USD,EUR
BILLING_CHECKOUT_SUCCESS_URL=http://localhost:5173/billing/success
BILLING_CHECKOUT_FAILURE_URL=http://localhost:5173/billing/failure
BILLING_CALLBACK_URL=http://localhost:5000/api/v1/billing/callback/iyzico
PAYMENT_PROVIDER_TIMEOUT_SECONDS=15

# Iyzico adapter credentials; keep placeholders out of production.
IYZICO_API_KEY=placeholder
IYZICO_SECRET=placeholder
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Market data provider boundary
MARKET_DATA_PROVIDER=sample
MARKET_DATA_TIMEOUT_SECONDS=10
MARKET_DATA_CACHE_TTL_SECONDS=300
